<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body, .body-wrap { width: 100% !important; height: 100%; background-color:
      #f4f4f4; margin: 0; padding: 0; font-family: Arial, sans-serif; }
      .container { width: 100%; max-width: 600px; margin: 0 auto; background:
      #ffffff; padding: 20px; border-radius: 8px; box-shadow: 0px 4px 12px
      rgba(0, 0, 0, 0.1); } .header { background-color:#71bc37; color: #ffffff;
      padding: 20px; text-align: center; border-top-left-radius: 8px;
      border-top-right-radius: 8px; } .header h1 { font-size: 24px; margin: 0; }
      .content { padding: 20px; font-size: 16px; color: #333333; } .content p {
      margin-bottom: 15px; line-height: 1.6; } .form-details { background:
      #f9f9f9; padding: 15px; border-radius: 6px; margin: 20px 0; }
      .form-details p { margin: 5px 0; font-size: 14px; } .button {
      display: inline-block; background-color: #71bc37; color: #ffffff;
      padding: 12px 25px; text-decoration: none; border-radius: 5px;
      font-weight: bold; margin: 10px 0; } .button:hover { background-color:
      #5a9e2a; } .footer { text-align: center; font-size: 12px; color:
      #777777; padding: 20px; background-color: #f4f4f4; }
    </style>
  </head>
